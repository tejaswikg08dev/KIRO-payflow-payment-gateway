{
  "info": {
    "name": "PayFlow Payment Gateway API",
    "description": "Complete API collection for PayFlow Payment Gateway.\n\nIncludes: Auth, Merchants, Orders, Payments, Settlements, Webhooks.\n\nSetup: Import this collection + environment files into Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "access_token", "value": "" },
    { "key": "merchant_id", "value": "" },
    { "key": "api_secret_key", "value": "" },
    { "key": "order_id", "value": "" },
    { "key": "payment_id", "value": "" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register Merchant",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/v1/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"merchant@test.com\",\"password\":\"SecureP@ss123\",\"fullName\":\"Test Merchant\",\"phone\":\"+919876543210\",\"role\":\"MERCHANT\"}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/v1/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"merchant@test.com\",\"password\":\"SecureP@ss123\"}"
            }
          }
        }
      ]
    },
    {
      "name": "2. Merchants",
      "item": [
        {
          "name": "Create Merchant",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/v1/merchants",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"userId\":\"usr_test123\",\"businessName\":\"TechShop India\",\"businessType\":\"COMPANY\",\"gstNumber\":\"27AABCU9603R1ZM\",\"websiteUrl\":\"https://techshop.in\",\"webhookUrl\":\"https://techshop.in/webhooks\"}"
            }
          }
        },
        {
          "name": "Get Merchant",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/v1/merchants/{{merchant_id}}"
          }
        },
        {
          "name": "Generate API Key (LIVE)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/v1/merchants/{{merchant_id}}/api-keys?keyType=LIVE"
          }
        },
        {
          "name": "List API Keys",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/v1/merchants/{{merchant_id}}/api-keys"
          }
        }
      ]
    },
    {
      "name": "3. Orders",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/v1/orders",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Api-Key", "value": "{{api_secret_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"amount\":5000.00,\"currency\":\"INR\",\"receipt\":\"order_test_001\",\"notes\":{\"product\":\"Wireless Headphones\"}}"
            }
          }
        },
        {
          "name": "Get Order",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/v1/orders/{{order_id}}",
            "header": [{ "key": "X-Api-Key", "value": "{{api_secret_key}}" }]
          }
        }
      ]
    },
    {
      "name": "4. Payments",
      "item": [
        {
          "name": "Authorize Card Payment",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/v1/payments",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Api-Key", "value": "{{api_secret_key}}" },
              { "key": "Idempotency-Key", "value": "idem_{{$randomUUID}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"orderId\":\"{{order_id}}\",\"amount\":5000.00,\"method\":\"card\",\"card\":{\"number\":\"4111111111111111\",\"expiryMonth\":12,\"expiryYear\":2028,\"cvv\":\"123\",\"holderName\":\"TEST USER\"}}"
            }
          }
        },
        {
          "name": "Authorize UPI Payment",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/v1/payments",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Api-Key", "value": "{{api_secret_key}}" },
              { "key": "Idempotency-Key", "value": "idem_upi_{{$randomUUID}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"orderId\":\"{{order_id}}\",\"amount\":1200.00,\"method\":\"upi\",\"upi\":{\"vpa\":\"rajesh@okicici\"}}"
            }
          }
        },
        {
          "name": "Capture Payment",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/v1/payments/{{payment_id}}/capture",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Api-Key", "value": "{{api_secret_key}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"amount\":5000.00}" }
          }
        },
        {
          "name": "Void Payment",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/v1/payments/{{payment_id}}/void",
            "header": [{ "key": "X-Api-Key", "value": "{{api_secret_key}}" }]
          }
        },
        {
          "name": "Refund Payment",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/v1/payments/{{payment_id}}/refund",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Api-Key", "value": "{{api_secret_key}}" }
            ],
            "body": { "mode": "raw", "raw": "{\"amount\":2000.00,\"reason\":\"Customer returned product\"}" }
          }
        },
        {
          "name": "Get Payment",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/v1/payments/{{payment_id}}",
            "header": [{ "key": "X-Api-Key", "value": "{{api_secret_key}}" }]
          }
        }
      ]
    },
    {
      "name": "5. Settlements",
      "item": [
        {
          "name": "List Settlements",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/v1/settlements",
            "header": [{ "key": "X-Merchant-Id", "value": "{{merchant_id}}" }]
          }
        },
        {
          "name": "Trigger Settlement (Admin)",
          "request": {
            "method": "POST",
            "url": "http://localhost:8085/internal/trigger"
          }
        }
      ]
    },
    {
      "name": "6. Webhooks",
      "item": [
        {
          "name": "List Webhook Events",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/v1/webhooks/events",
            "header": [{ "key": "X-Api-Key", "value": "{{api_secret_key}}" }]
          }
        }
      ]
    },
    {
      "name": "7. Routing (Internal)",
      "item": [
        {
          "name": "Route Payment (Internal)",
          "request": {
            "method": "POST",
            "url": "http://localhost:8084/internal/route",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"paymentId\":\"pay_test\",\"cardNumber\":\"4111111111111111\",\"cardExpiry\":\"2812\",\"cardLast4\":\"1111\",\"amount\":500000,\"currency\":\"INR\",\"merchantId\":\"merch_test\"}"
            }
          }
        }
      ]
    },
    {
      "name": "8. Health Checks",
      "item": [
        { "name": "Gateway Health", "request": { "method": "GET", "url": "http://localhost:8080/actuator/health" } },
        { "name": "Identity Health", "request": { "method": "GET", "url": "http://localhost:8081/actuator/health" } },
        { "name": "Payment Health", "request": { "method": "GET", "url": "http://localhost:8083/actuator/health" } },
        { "name": "Routing Health", "request": { "method": "GET", "url": "http://localhost:8084/actuator/health" } },
        { "name": "Eureka Dashboard", "request": { "method": "GET", "url": "http://localhost:8761" } }
      ]
    }
  ]
}
